# Optional environment variables.
# The filesystem upload pipeline works without a .env file.

# App
# LOG_LEVEL=INFO
# STORAGE_DIR=backend/storage

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# PostgreSQL (required for Copilot MasterSheet SQL execution)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/insurance

# Copilot
# COPILOT_MAX_SQL_RETRIES=3
# COPILOT_MEMORY_TURNS=6
# COPILOT_MASTERSHEET_TABLE=mastersheet
# COPILOT_CASE_FILTER_COLUMN=case_id

# Auth (optional — disabled by default)
# AUTH_ENABLED=false
